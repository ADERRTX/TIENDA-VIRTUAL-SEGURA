{
  "name": "tienda-virtual-segura",
  "version": "1.0.0",
  "description": "Tienda Virtual Segura - Monolito modular TypeScript",
  "private": true,
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.4.0"
  },
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r tsc --noEmit",
    "test": "pnpm -r test",
    "test:int": "pnpm -r test:int",
    "test:e2e": "pnpm -r test:e2e",
    "db:seed": "pnpm --filter backend run db:seed",
    "demo:reset": "docker compose down -v && docker compose up -d db storage mailpit && pnpm db:seed",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "verify:full": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:int && pnpm test:e2e",
    "security:scan": "node scripts/security-scan.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-security": "^1.7.0",
    "husky": "^8.0.0",
    "prettier": "^3.2.5"
  }
}