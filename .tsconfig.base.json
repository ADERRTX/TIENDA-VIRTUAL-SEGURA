{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@": ["../../frontend"],
      "@shared": ["../../shared"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "tests"]
}