{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@tvs/shared/enums": ["../shared/dist/enums"],
      "@tvs/shared/errors": ["../shared/dist/errors"],
      "@tvs/shared/constants": ["../shared/dist/constants"],
      "@tvs/shared/schemas": ["../shared/dist/schemas"],
      "@tvs/shared": ["../shared/dist"],
      "@modules/*": ["src/modules/*"]
    },
    "outDir": "./dist",
    "rootDir": "./src",
    "removeComments": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}