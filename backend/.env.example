# .env.example for Tienda Virtual Segura (backend)
# -------------------------------------------------
# Application mode (development | production)
NODE_ENV=development

# HTTP port (default 3000)
PORT=3000

# Database connection (PostgreSQL) – required in all environments
# Example for local Docker instance:
#   postgres://user:password@localhost:5433/tvs-db
DATABASE_URL=postgres://<user>:<password>@localhost:5433/tvs-db

# JWT secret (must be >= 32 characters). In production this must be set.
# For local development you can use a short dummy value, but the code enforces length.
JWT_SECRET=your-very-long-secret-key-at-least-32-chars

# Optional fallback session secret (used if JWT_SECRET not set)
SESSION_SECRET=your-session-secret

# CORS allowed origins (comma‑separated). Must be defined in production.
# Include the frontend URL(s) here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Argon2id parameters (optional – can be overridden in code)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Idempotency‑Key header name (used by services)
IDEMPOTENCY_HEADER=idempotency-key

# Other optional settings (example placeholders)
# LOG_LEVEL=info
# REDIS_URL=redis://localhost:6379
