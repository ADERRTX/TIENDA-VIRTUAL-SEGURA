# ==============================================================================
# TIENDA VIRTUAL SEGURA (TVS) — Variables de Entorno (Backend)
# ==============================================================================
# Copie este archivo a .env y configure los valores correspondientes.
# NUNCA guarde contraseñas ni secretos reales en el control de versiones.

# Modo de ejecución de la aplicación: 'development' | 'production' | 'test'
# En 'production': Swagger desactivado, cookies Secure habilitadas, validaciones estrictas.
NODE_ENV=production

# Puerto HTTP en el que escuchará el servidor NestJS (por defecto: 3000)
PORT=3000

# Conexión a la base de datos PostgreSQL 16
# En producción debe apuntar a la instancia aislada en red interna (sin exponer puerto al exterior)
# Formato: postgresql://<usuario>:<password>@<host>:<puerto>/<nombre_db>?schema=public
DATABASE_URL=postgresql://tvs_prod_user:CHANGE_ME_STRONG_PASSWORD@tvs-prod-db:5432/tienda_virtual_segura?schema=public

# Secreto de firma JWT (OBLIGATORIO en producción: mínimo 32 caracteres criptográficamente seguros)
# Puede generarse con: openssl rand -base64 36
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_DE_AL_MENOS_32_CARACTERES_HEX_O_BASE64

# Orígenes CORS permitidos (separados por coma, sin comodines '*' en producción)
# Es OBLIGATORIO definirlo en producción; de lo contrario el backend no iniciará.
CORS_ORIGINS=https://tvs.pe,https://www.tvs.pe,https://admin.tvs.pe

# Directorio de almacenamiento para archivos e imágenes subidas
# Si se omite, por defecto se usará una carpeta 'uploads' relativa a la raíz del backend.
UPLOAD_DIR=/app/uploads

# Parámetros del algoritmo de hashing Argon2id (opcionales; predeterminados según OWASP)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
