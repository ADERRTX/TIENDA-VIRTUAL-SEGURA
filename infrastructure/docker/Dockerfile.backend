FROM node:20.11.0-alpine AS builder

WORKDIR /app

# Copiar archivos de workspace
COPY package.json pnpm-lock.yaml .npmrc ./
COPY pnpm-workspace.yaml ./
COPY backend/package.json backend/
COPY backend/prisma backend/prisma/
COPY backend/src backend/src/
COPY shared/package.json shared/
COPY shared/src shared/src/

# Instalar dependencias
RUN npm install -g pnpm@9.4.0
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile --prod

# Build del backend
RUN pnpm --filter backend build

# Etapa de producción
FROM node:20.11.0-alpine

WORKDIR /app

# Crear usuario no root
RUN addgroup -g 1001 appgroup && adduser -D -u 1001 -G appgroup appuser
RUN mkdir -p /app/backend/dist && chown -R appuser:appgroup /app/backend/dist

# Copiar build del backend
COPY --from=builder --chown=appuser:appgroup /app/backend/dist ./backend/dist
COPY --from=builder --chown=appuser:appgroup /app/backend/package.json ./backend/
COPY --from=builder --chown=appuser:appgroup /app/backend/prisma ./backend/prisma/
COPY --from=builder --chown=appuser:appgroup /app/shared ./shared
COPY --from=builder --chown=appuser:appgroup /app/node_modules ./node_modules

USER appuser

EXPOSE 3000

ENV NODE_ENV=production
ENV TZ=UTC
ENV PORT=3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:3000/api/health || exit 1

CMD ["node", "backend/dist/main.js"]