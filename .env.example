# PostgreSQL (docker compose)
POSTGRES_USER=tvs_user
POSTGRES_PASSWORD=cambiar_esta_contrasena
POSTGRES_DB=tienda_virtual_segura

# Backend
# Nota: el host usa 5433 porque 5432 está ocupado por un Postgres local
DATABASE_URL="postgresql://tvs_user:cambiar_esta_contrasena@localhost:5433/tienda_virtual_segura?schema=public"
PORT=3000
NODE_ENV=development
SESSION_SECRET=cambiar_este_secreto_largo
UPLOAD_DIR=./uploads
